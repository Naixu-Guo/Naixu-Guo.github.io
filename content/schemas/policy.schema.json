{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "policy content, version 1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "homeNewsLimit": {
      "const": 5
    },
    "ownerNames": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excludedTitles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceProfiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "arxiv": {
          "type": "string"
        },
        "linkedin": {
          "type": "string"
        }
      },
      "required": [
        "arxiv",
        "linkedin"
      ]
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "homeNewsLimit",
    "ownerNames",
    "excludedTitles",
    "sourceProfiles"
  ]
}
