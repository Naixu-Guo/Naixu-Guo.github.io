{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "library content, version 1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "intro": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "author": {
                        "type": "string"
                      },
                      "link": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "note": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "title",
                      "link",
                      "type"
                    ]
                  }
                }
              },
              "required": [
                "title",
                "items"
              ]
            }
          }
        },
        "required": [
          "title",
          "description",
          "groups"
        ]
      }
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "intro",
    "categories"
  ]
}
