{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "publication content, version 1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "verification": {
      "enum": [
        "inherited",
        "source-checked",
        "author-confirmed"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "arxiv",
              "publisher",
              "web",
              "social",
              "author"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "anyOf": [
          {
            "required": [
              "url"
            ]
          },
          {
            "required": [
              "note"
            ]
          }
        ]
      }
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "formerTitle": {
      "type": "string"
    },
    "authors": {
      "type": "string",
      "minLength": 1
    },
    "venue": {
      "type": "string",
      "minLength": 1
    },
    "short": {
      "type": "string",
      "minLength": 1
    },
    "year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2200
    },
    "category": {
      "enum": [
        "preprint",
        "journal",
        "conference",
        "book"
      ]
    },
    "arxiv": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{4,5}$"
    },
    "doi": {
      "type": "string"
    },
    "journalLink": {
      "type": "string"
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "label",
        "href"
      ]
    },
    "figure": {
      "type": "string"
    },
    "figureSurface": {
      "enum": ["paper", "slate"],
      "description": "Figure backing. Use slate for transparent figures with light lettering; paper is the default."
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "selected": {
      "type": "boolean"
    },
    "code": {
      "type": "string",
      "pattern": "^https?://"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "authors",
    "venue",
    "short",
    "year",
    "category",
    "summary",
    "verification",
    "sources"
  ]
}
