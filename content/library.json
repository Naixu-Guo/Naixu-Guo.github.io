{
  "$schema": "./schemas/library.schema.json",
  "schemaVersion": 1,
  "intro": "Books, lecture notes, and surveys I keep returning to, in quantum computing, machine learning, and the mathematics underneath both. Short by design.",
  "categories": [
    {
      "title": "Quantum computing",
      "description": "Algorithms, learning, complexity, error correction, and open systems.",
      "groups": [
        {
          "title": "Algorithms",
          "items": [
            {
              "title": "Lecture notes on quantum algorithms",
              "author": "Andrew Childs",
              "link": "https://www.cs.umd.edu/~amchilds/qa/",
              "type": "notes",
              "note": "The standard toolkit from quantum walks to Hamiltonian simulation."
            },
            {
              "title": "Quantum computing: lecture notes",
              "author": "Ronald de Wolf",
              "link": "https://arxiv.org/abs/1907.09415",
              "type": "notes",
              "note": "Compact, with exercises; strong on query complexity and lower bounds."
            },
            {
              "title": "Lecture notes on quantum algorithms for scientific computation",
              "author": "Lin Lin",
              "link": "https://arxiv.org/abs/2201.08309",
              "type": "notes",
              "note": "Linear systems, simulation, and block encodings."
            }
          ]
        },
        {
          "title": "Learning",
          "items": [
            {
              "title": "A survey of quantum learning theory",
              "author": "Arunachalam and de Wolf",
              "link": "https://arxiv.org/abs/1701.06806",
              "type": "survey"
            },
            {
              "title": "A survey on the complexity of learning quantum states",
              "author": "Anshu and Arunachalam",
              "link": "https://arxiv.org/abs/2305.20069",
              "type": "survey"
            },
            {
              "title": "The randomized measurement toolbox",
              "author": "Elben et al.",
              "link": "https://arxiv.org/abs/2203.11374",
              "type": "survey",
              "note": "Classical shadows and their relatives."
            },
            {
              "title": "Introduction to Haar measure tools in quantum information",
              "author": "Mele",
              "link": "https://arxiv.org/abs/2307.08956",
              "type": "survey",
              "note": "Weingarten calculus and unitary designs, written for use."
            }
          ]
        },
        {
          "title": "Complexity",
          "items": [
            {
              "title": "The quantum PCP conjecture",
              "author": "Aharonov, Arad, and Vidick",
              "link": "https://arxiv.org/abs/1309.7495",
              "type": "survey"
            },
            {
              "title": "Quantum proofs",
              "author": "Vidick and Watrous",
              "link": "https://arxiv.org/abs/1610.01664",
              "type": "survey",
              "note": "QMA and its variants."
            }
          ]
        },
        {
          "title": "Error correction",
          "items": [
            {
              "title": "Surviving as a quantum computer in a classical world",
              "author": "Daniel Gottesman",
              "link": "https://www.cs.umd.edu/~dgottesm/QECCbook-2026.pdf",
              "type": "book",
              "note": "A textbook on error correction and fault tolerance, in draft."
            },
            {
              "title": "Lecture notes on quantum error correction",
              "author": "Anthony Leverrier",
              "link": "https://who.rocq.inria.fr/Andre.Chailloux/LectureNotesLeverrier.pdf",
              "type": "notes"
            }
          ]
        },
        {
          "title": "Information theory and open systems",
          "items": [
            {
              "title": "The theory of quantum information",
              "author": "John Watrous",
              "link": "https://cs.uwaterloo.ca/~watrous/TQI/TQI.pdf",
              "type": "book",
              "note": "The rigorous reference for channels, distinguishability, and semidefinite programming."
            },
            {
              "title": "Lecture notes on the theory of open quantum systems",
              "author": "Daniel Lidar",
              "link": "https://arxiv.org/abs/1902.00967",
              "type": "notes",
              "note": "Master equations and the Lindblad form, derived carefully."
            }
          ]
        }
      ]
    },
    {
      "title": "Machine learning",
      "description": "Learning theory, deep learning, and statistical learning.",
      "groups": [
        {
          "title": "Theory",
          "items": [
            {
              "title": "Reproducing kernel Hilbert spaces in machine learning",
              "author": "Arthur Gretton",
              "link": "https://www.gatsby.ucl.ac.uk/~gretton/coursefiles/rkhscourse.html",
              "type": "notes"
            },
            {
              "title": "Statistical learning theory (CS229T)",
              "author": "Tengyu Ma",
              "link": "https://web.stanford.edu/class/cs229t/",
              "type": "notes"
            },
            {
              "title": "Neural tangent kernel papers",
              "link": "https://arxiv.org/search/?query=neural+tangent+kernel&searchtype=all",
              "type": "collection"
            },
            {
              "title": "The information bottleneck problem and its applications in machine learning",
              "author": "Goldfeld and Polyanskiy",
              "link": "https://arxiv.org/abs/2004.14941",
              "type": "survey"
            },
            {
              "title": "Diffusion models: a comprehensive survey of methods and applications",
              "author": "Yang et al.",
              "link": "https://arxiv.org/abs/2209.00796",
              "type": "survey"
            }
          ]
        },
        {
          "title": "Deep learning",
          "items": [
            {
              "title": "Deep learning",
              "author": "Goodfellow, Bengio, and Courville",
              "link": "https://www.deeplearningbook.org/",
              "type": "book"
            },
            {
              "title": "Neural networks and deep learning",
              "author": "Michael Nielsen",
              "link": "http://neuralnetworksanddeeplearning.com/",
              "type": "book"
            }
          ]
        },
        {
          "title": "Statistical learning",
          "items": [
            {
              "title": "Pattern recognition and machine learning",
              "author": "Christopher Bishop",
              "link": "https://www.microsoft.com/en-us/research/wp-content/uploads/2006/01/Bishop-Pattern-Recognition-and-Machine-Learning-2006.pdf",
              "type": "book"
            },
            {
              "title": "The elements of statistical learning",
              "author": "Hastie, Tibshirani, and Friedman",
              "link": "https://hastie.su.domains/ElemStatLearn/",
              "type": "book"
            }
          ]
        }
      ]
    },
    {
      "title": "Mathematics",
      "description": "Graphs, Markov chains, analysis, concentration, and optimization.",
      "groups": [
        {
          "title": "Graphs and Markov chains",
          "items": [
            {
              "title": "Spectral and algebraic graph theory",
              "author": "Daniel Spielman",
              "link": "https://www.cs.yale.edu/homes/spielman/sagt/sagt.pdf",
              "type": "book"
            },
            {
              "title": "Markov chains and mixing times",
              "author": "Levin and Peres",
              "link": "https://pages.uoregon.edu/dlevin/MARKOV/mcmt2e.pdf",
              "type": "book",
              "note": "Mixing times, coupling, and spectral methods."
            }
          ]
        },
        {
          "title": "Analysis and concentration",
          "items": [
            {
              "title": "Analysis of Boolean functions",
              "author": "Ryan O'Donnell",
              "link": "https://arxiv.org/abs/2105.10386",
              "type": "book",
              "note": "Fourier analysis on the Boolean cube."
            },
            {
              "title": "An introduction to matrix concentration inequalities",
              "author": "Joel Tropp",
              "link": "https://arxiv.org/abs/1501.01571",
              "type": "notes",
              "note": "Matrix Bernstein and its relatives, with proofs."
            }
          ]
        },
        {
          "title": "Optimization",
          "items": [
            {
              "title": "Introduction to online convex optimization",
              "author": "Elad Hazan",
              "link": "https://arxiv.org/abs/1909.05207",
              "type": "book",
              "note": "Regret bounds from first principles."
            }
          ]
        }
      ]
    }
  ]
}
